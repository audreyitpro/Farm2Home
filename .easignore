# Dependencies - EAS installs these from package-lock.json
node_modules/

# Expo local files
.expo/
.expo-shared/

# Local environment files
.env
.env.*
backend/.env
*.env

# Local Android SDK configuration
android/local.properties

# Android build outputs/caches
android/.gradle/
android/build/
android/app/build/
android/.cxx/
