# iOS local build artifacts
ios/Pods/
ios/build/

# General build output
dist/
web-build/

# Git / editor / OS
.git/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
gradle-debug.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Credentials / certificates
credentials.json
credentials/
*.jks
*.keystore
